# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3000

# ── Enquiry email (Google Workspace SMTP) ──
# srpitl.com runs on Google Workspace, so use Gmail SMTP.
#
# IMPORTANT: SMTP_USER must be a REAL individual mailbox, NOT a group.
# clientrelations@srpitl.com is a Google Group — groups have no password and
# cannot be used for SMTP login. Authenticate as a real user account (e.g. a
# dedicated noreply@srpitl.com or any staff mailbox) and deliver TO the group.
#
# SMTP_USER: an individual Workspace mailbox to send AS / log in with
# SMTP_PASS: a 16-char Google App Password for THAT account (needs 2-Step Verification ON)
#            Create at: https://myaccount.google.com/apppasswords
SMTP_USER=noreply@srpitl.com
SMTP_PASS=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Where enquiries are delivered — the group address is fine here.
ENQUIRY_TO=clientrelations@srpitl.com

# ── Durable fallback capture (optional) ──
# If SMTP is down or a send fails, the contact/subscribe enquiry is POSTed here
# as JSON so the lead is never lost. Point it at whatever the team monitors:
#   • Google Sheet  — deploy an Apps Script web app that appends rows, use its /exec URL
#   • Slack/Discord — an incoming webhook URL
#   • Zapier/Make   — a catch-hook URL
# Payload: { kind: "contact"|"subscribe", receivedAt, name, email, phone, ... }
# Leave unset to keep the current behaviour (no fallback; a PII-free tag is logged).
# ENQUIRY_WEBHOOK_URL=

# Optional salt for the PII log correlation tag (piiTag). Any random secret;
# defaults to ENQUIRY_TO when unset. Set a real value to make tags harder to
# rainbow-table against a known email list.
# LOG_SALT=
