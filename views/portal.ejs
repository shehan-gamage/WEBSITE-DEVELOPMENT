<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <!-- ══ PORTAL LOGIN ════════════════════════════════ -->
  <section class="portal-login-section">
    <div class="portal-login-bg">
      <div class="portal-login-grid"></div>
      <div class="portal-login-glow"></div>
    </div>
    <div class="portal-login-container">
      <div class="portal-login-card<%= portalLive ? '' : ' portal-soon' %>">
        <% if (!portalLive) { %><span class="portal-badge">Launching Soon</span><% } %>
        <h1>Client Portal</h1>

        <% if (portalLive) { %>
        <p class="portal-login-subtitle">Access your secure business dashboard</p>

        <form class="portal-login-form">
          <div class="form-group">
            <label for="portalEmail">Email Address</label>
            <input type="email" id="portalEmail" placeholder="you@company.com" autocomplete="email">
          </div>
          <div class="form-group">
            <label for="portalPassword">Password</label>
            <input type="password" id="portalPassword" placeholder="Enter your password" autocomplete="current-password">
          </div>
          <button type="submit" class="btn btn-primary btn-lg" style="width:100%; justify-content:center;">
            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Secure Login
          </button>
          <div class="portal-login-links">
            <a href="#">Forgot Password?</a>
            <a href="/contact">Don't have an account? Contact us</a>
          </div>
        </form>

        <div class="portal-security-note">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Secured with enterprise-grade encryption. Your data is safe with SRP.</span>
        </div>
        <% } else { %>
        <p class="portal-login-subtitle">Your secure business dashboard is on its way.</p>

        <div class="portal-soon-body">
          <span class="portal-soon-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><polyline points="12 7.5 12 12 15.5 14"/></svg>
          </span>
          <p class="portal-soon-text">We&rsquo;re putting the finishing touches on your Client Portal &mdash; one secure place to manage your documents, compliance, invoices, and services with SRP. It will be available right here shortly.</p>
          <p class="portal-soon-text">Already an SRP client? Get in touch and we&rsquo;ll set up your access the moment it goes live.</p>
          <a href="/contact" class="btn btn-primary btn-lg portal-soon-cta">Contact Us <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>

        <div class="portal-security-note">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Built with enterprise-grade encryption &mdash; your data will be safe with SRP.</span>
        </div>
        <% } %>
      </div>
    </div>
  </section>


  <!-- ══ PORTAL CTA ══════════════════════════════════ -->
  <section class="cta-band">
    <h2>Be First on the Client Portal</h2>
    <p>The SRP Client Portal is launching soon. Contact us and we&rsquo;ll set up your account so you&rsquo;re ready the moment it goes live.</p>
    <div class="cta-band-btns">
      <a href="/contact" class="btn btn-white">Contact SRP <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/services" class="btn btn-ghost">Explore Services</a>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <%- include('partials/scripts') %>
</body>
</html>
