<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <!-- ══ PAGE HERO ═══════════════════════════════════ -->
  <section class="page-hero">
    <div class="hero-grid"></div>
    <div class="page-hero-content">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        <span>Contact Us</span>
      </div>
      <h1>Let's Discuss How SRP Can <br class="hero-line-break">Support Your Business</h1>
      <p>Contact our team to learn how SRP International can support your company with corporate services, compliance, finance, HR, research, and business planning.</p>
    </div>
  </section>


  <!-- ══ CONTACT FORM ════════════════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <div class="contact-layout">
        <div class="contact-info reveal">
          <h2 class="heading" style="text-align:left;">Get in Touch</h2>
          <p class="contact-intro">Whether you're starting a new venture or streamlining your existing operations, we're here to provide tailored corporate services that genuinely move your business forward. Send us an inquiry and we'll route it to the right regional team.</p>

          <div class="contact-items">
            <div class="contact-row">
              <div class="contact-ico">
                <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <div class="contact-row-label">Email</div>
                <div class="contact-row-val"><a href="mailto:info@srpitl.com">info@srpitl.com</a></div>
              </div>
            </div>
            <div class="contact-row">
              <div class="contact-ico contact-ico--wa">
                <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05.001C5.495.001.16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              </div>
              <div>
                <div class="contact-row-label">WhatsApp</div>
                <div class="contact-row-val"><a href="<%= whatsapp.href %>" target="_blank" rel="noopener noreferrer"><%= whatsapp.display %></a></div>
              </div>
            </div>
            <div class="contact-row">
              <div class="contact-ico">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <div class="contact-row-label">Response Time</div>
                <div class="contact-row-val">Within 24 hours, Mon–Fri</div>
              </div>
            </div>
            <div class="contact-row">
              <div class="contact-ico">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </div>
              <div>
                <div class="contact-row-label">Regional Offices</div>
                <div class="contact-row-val">
                  <a href="#sri-lanka">Sri Lanka</a> ·
                  <a href="#singapore">Singapore</a> ·
                  <a href="#uae">UAE</a> ·
                  <a href="#uk">UK</a> ·
                  <a href="#hong-kong">Hong Kong</a>
                </div>
              </div>
            </div>
          </div>

          <div class="contact-next">
            <div class="contact-next-title">What happens next</div>
            <ol class="contact-next-list">
              <li>We review your inquiry and route it to the right regional team.</li>
              <li>A specialist replies within 24 hours, Monday to Friday.</li>
              <li>We arrange a short, no-obligation call to understand your needs.</li>
            </ol>
            <a class="wa-btn" href="<%= whatsapp.href %>" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05.001C5.495.001.16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              Chat on WhatsApp
            </a>
          </div>
        </div>

        <div class="contact-form-card reveal">
          <h3 style="font-size:20px; font-weight:700; margin-bottom:24px;">Send Us an Inquiry</h3>
          <form id="contactForm">
            <div class="form-row">
              <div class="form-group">
                <label for="fName">Full Name *</label>
                <input type="text" id="fName" name="name" placeholder="Your full name" required autocomplete="name">
              </div>
              <div class="form-group">
                <label for="fEmail">Email Address *</label>
                <input type="email" id="fEmail" name="email" placeholder="you@company.com" required autocomplete="email">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="fPhone">Contact Number</label>
                <input type="tel" id="fPhone" name="phone" placeholder="+94 XX XXX XXXX" autocomplete="tel">
              </div>
              <div class="form-group">
                <label for="fCompany">Company Name</label>
                <input type="text" id="fCompany" name="company" placeholder="Your company" autocomplete="organization">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="fService">Service Interest</label>
                <select id="fService" name="service">
                  <option value="">Select a service...</option>
                  <option>Company Incorporation & Governance</option>
                  <option>Financial Services</option>
                  <option>Research & Business Planning</option>
                  <option>Human Resource Management</option>
                  <option>Multiple Services</option>
                </select>
              </div>
              <div class="form-group">
                <label for="fSubject">Subject</label>
                <input type="text" id="fSubject" name="subject" placeholder="How can we help?">
              </div>
            </div>
            <div class="form-group">
              <label for="fMsg">Message *</label>
              <textarea id="fMsg" name="message" placeholder="Tell us about your business needs..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-lg" id="contactBtn" style="width:100%; justify-content:center;">Submit Inquiry</button>
            <p class="form-consent">By submitting this form, you agree to our <a href="/privacy">Privacy Policy</a> and consent to SRP International contacting you about your inquiry.</p>
          </form>
        </div>
      </div>
    </div>
  </section>


  <!-- ══ MEETING CTA ═════════════════════════════════ -->
  <section class="section">
    <div class="container" style="text-align:center; max-width:600px;">
      <div class="kicker">Prefer to Talk?</div>
      <h2 class="heading">Prefer to Speak With Us Directly?</h2>
      <p class="subheading" style="margin-bottom:32px;">Schedule a meeting with one of our corporate services advisors to discuss your business needs in detail.</p>
      <a href="mailto:info@srpitl.com?subject=Meeting%20Request" class="btn btn-primary btn-lg">Schedule a Meeting <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    </div>
  </section>

  <!-- ══ FINAL CTA ═══════════════════════════════════ -->
  <section class="cta-band">
    <h2>Ready to Simplify Your Corporate Operations?</h2>
    <p>Partner with SRP International for reliable corporate services, business support, and technology-enabled client management.</p>
    <div class="cta-band-btns" style="justify-content:center;">
      <a href="/services" class="btn btn-white">Explore Services <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <%- include('partials/scripts') %>
</body>
</html>
