<article class="blog-card">
  <a class="blog-card-link" href="/blog/<%= post.slug %>" aria-label="<%= post.title %>">
    <div class="blog-card-media">
      <img src="<%= post.image %>" alt="" loading="lazy" width="640" height="360">
      <span class="blog-pill"><%= categoryName(post.category) %></span>
    </div>
    <div class="blog-card-body">
      <h3 class="blog-card-title"><%= post.title %></h3>
      <p class="blog-card-excerpt"><%= post.excerpt %></p>
      <div class="blog-meta">
        <img class="blog-meta-avatar" src="<%= post.author.avatar %>" alt="" loading="lazy" width="28" height="28">
        <span class="blog-meta-author"><%= post.author.name %></span>
        <span class="blog-meta-dot" aria-hidden="true">·</span>
        <span><%= fmtDate(post.date) %></span>
        <span class="blog-meta-dot" aria-hidden="true">·</span>
        <span><%= readingTime(post) %> min read</span>
      </div>
    </div>
  </a>
</article>
