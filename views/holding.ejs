<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <% const label = (typeof office !== 'undefined' && office) ? office.label : 'This page'; %>
  <section class="page-hero" style="min-height:66vh; display:flex; align-items:center;">
    <div class="hero-grid"></div>
    <div class="page-hero-content">
      <div style="display:inline-flex; align-items:center; justify-content:center; width:72px; height:72px; margin:0 auto 24px; border-radius:50%; background:rgba(255,255,255,.10); border:1px solid rgba(255,255,255,.22);">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 3 21 9 15 9"/>
        </svg>
      </div>
      <h1 style="font-size:var(--fs-h1); font-weight:800; margin-bottom:16px;">This page is being updated</h1>
      <p style="max-width:52ch; margin:0 auto 32px;">We're refreshing our <%= label %> information and it will be back shortly. Thank you for your patience.</p>
      <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a href="/" class="btn btn-white">Back to Home <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="/contact" class="btn btn-ghost">Contact Us</a>
      </div>
      <p style="margin-top:28px; font-size:14px; color:rgba(255,255,255,.75);">
        For anything urgent, email us at
        <a href="mailto:info@srpitl.com" style="color:#fff; font-weight:600; text-decoration:underline;">info@srpitl.com</a>.
      </p>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <%- include('partials/scripts') %>
</body>
</html>
