<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <!-- ══ PAGE HERO ═══════════════════════════════════ -->
  <section class="page-hero about-hero">
    <div class="hero-grid"></div>
    <div class="page-hero-content">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        <span>About Us</span>
      </div>
      <h1>Your Trusted <em>Corporate Services Partner</em></h1>
      <p>SRP International supports businesses with reliable, transparent, and dependable corporate services across six markets — and stays with them as they grow.</p>
    </div>
  </section>

  <!-- ══ COMPANY STORY ═══════════════════════════════ -->
  <section class="section story-section">
    <div class="container">
      <div class="story-grid">
        <div class="story-text reveal">
          <div class="kicker">Our Story</div>
          <h2 class="heading" style="text-align:left;">Building Trust Since 2017</h2>
          <p class="story-lede">SRP International was founded on a simple idea: businesses deserve corporate services they can count on — reliable, transparent, and built for the long term.</p>
          <p>We bring together expertise in corporate law, finance, research, and human resources under one roof. Whether you're starting a new company in Sri Lanka, expanding into Singapore or Dubai, or refining an established business, we provide the specialist knowledge and hands-on support to do it well.</p>
          <p>Today, we serve over 650 companies across six markets, with structured, technology-enabled services that take the complexity out of running a business.</p>
        </div>

        <!-- Highlights panel — what sets SRP apart, replaces basic stats -->
        <aside class="story-highlights reveal" aria-label="What sets us apart">
          <div class="highlights-header">
            <span class="highlights-kicker">What sets us apart</span>
            <h3>A coordinated partner, not a vendor</h3>
          </div>
          <ul class="highlights-list">
            <li>
              <div class="hl-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
              <div>
                <strong>Multi-jurisdiction expertise</strong>
                <span>Sri Lanka · Singapore · UAE · United Kingdom · Hong Kong · Guernsey</span>
              </div>
            </li>
            <li>
              <div class="hl-icon"><svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
              <div>
                <strong>End-to-end coordination</strong>
                <span>Compliance, finance, research, and HR under one roof</span>
              </div>
            </li>
            <li>
              <div class="hl-icon"><svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div>
              <div>
                <strong>Technology-enabled delivery</strong>
                <span>Digital-first processes for speed and transparency</span>
              </div>
            </li>
            <li>
              <div class="hl-icon"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg></div>
              <div>
                <strong>Senior-led engagement</strong>
                <span>Experienced leaders involved on every account</span>
              </div>
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- ══ VALUES — editorial numbered list ═══════════ -->
  <section class="section section-dark values-section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Our Values</div>
        <h2 class="heading">The Principles That Guide Everything We Do</h2>
        <p class="subheading">Five commitments that shape how we work and how we treat every client relationship.</p>
      </div>

      <ol class="values-list">
        <li class="value-row reveal">
          <span class="value-num" aria-hidden="true">01</span>
          <div class="value-body">
            <h3 class="value-name">Transparency</h3>
            <p class="value-text">Open, honest communication with clients at every stage of service delivery — no surprises, no hidden steps.</p>
          </div>
          <div class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
        </li>

        <li class="value-row reveal reveal-delay-1">
          <span class="value-num" aria-hidden="true">02</span>
          <div class="value-body">
            <h3 class="value-name">Responsiveness</h3>
            <p class="value-text">Quick, proactive responses that keep clients informed and projects moving forward without bottlenecks.</p>
          </div>
          <div class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
          </div>
        </li>

        <li class="value-row reveal reveal-delay-2">
          <span class="value-num" aria-hidden="true">03</span>
          <div class="value-body">
            <h3 class="value-name">Integrity</h3>
            <p class="value-text">Ethical, principled service delivery that builds lasting trust with every client we work with.</p>
          </div>
          <div class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
        </li>

        <li class="value-row reveal reveal-delay-3">
          <span class="value-num" aria-hidden="true">04</span>
          <div class="value-body">
            <h3 class="value-name">Collaboration</h3>
            <p class="value-text">Working closely with clients as partners rather than providers — aligned on shared goals and outcomes.</p>
          </div>
          <div class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
        </li>

        <li class="value-row reveal reveal-delay-4">
          <span class="value-num" aria-hidden="true">05</span>
          <div class="value-body">
            <h3 class="value-name">Mutual Respect</h3>
            <p class="value-text">Treating every client relationship with care, professionalism, and genuine respect for their business goals.</p>
          </div>
          <div class="value-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ══ TECHNOLOGY-ENABLED — 3-col card grid ═══════ -->
  <section class="section tech-section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Technology-Enabled</div>
        <h2 class="heading">Modern Tools for Better Service Delivery</h2>
        <p class="subheading">We use modern technology to deliver corporate services that are faster, clearer, and easier to work with — without losing the human touch.</p>
      </div>

      <div class="tech-grid">
        <article class="tech-card reveal">
          <div class="tech-card-icon">
            <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3>Online Communication</h3>
          <p>Secure, real-time channels for efficient collaboration between clients and our service teams.</p>
        </article>

        <article class="tech-card reveal reveal-delay-1">
          <div class="tech-card-icon">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 14 11 16 15 12"/></svg>
          </div>
          <h3>Digital Records &amp; Signatures</h3>
          <p>Paperless, audit-ready document management paired with legally compliant digital signing — faster execution and approvals across all jurisdictions.</p>
        </article>

        <article class="tech-card reveal reveal-delay-2">
          <div class="tech-card-icon">
            <svg viewBox="0 0 24 24"><path d="M12 3l1.9 5.4L19 10l-5 1.7L12 17l-1.9-5.3L5 10l5.1-1.6L12 3z"/><path d="M19 14l.7 2L22 17l-2.3 1L19 20l-.7-2L16 17l2.3-1L19 14z"/><path d="M5 5l.6 1.6L7 7l-1.4.4L5 9l-.6-1.6L3 7l1.4-.4L5 5z"/></svg>
          </div>
          <h3>AI Integration</h3>
          <p>Intelligent automation and AI-powered analysis to accelerate compliance reviews, document processing, and reporting workflows.</p>
        </article>

        <article class="tech-card reveal reveal-delay-1">
          <div class="tech-card-icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3>Compliance Tracking</h3>
          <p>Proactive status updates and milestone notifications for every active service and regulatory deadline.</p>
        </article>

        <article class="tech-card reveal reveal-delay-2">
          <div class="tech-card-icon">
            <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h3>Client Dashboard</h3>
          <p>A secure portal — coming soon — for clients to manage documents, compliance, and services in one place.</p>
          <span class="tech-card-tag">Coming Soon</span>
        </article>

        <article class="tech-card reveal reveal-delay-3">
          <div class="tech-card-icon">
            <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3>Continuous Updates</h3>
          <p>Regular reports, audit-ready records, and real-time visibility into the work we deliver for you.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ══ TEAM — Uniform Portrait Grid ════════════════ -->
  <section class="section section-dark team-section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Our Team</div>
        <h2 class="heading">Leadership</h2>
        <p class="subheading">Our experienced leadership team brings deep expertise across corporate law, finance, research, and human resources.</p>
      </div>

    </div>

    <!-- Accordion gallery: hover expands -->
    <div class="team-gallery" aria-label="Leadership team gallery">
      <% team.forEach(function(m, i) { %>
      <div class="tg-tile" aria-label="<%= m.name %>, <%= m.role %>">

        <% if (m.photo) { %>
          <img class="tg-img tg-img--<%= m.firstName.toLowerCase() %>"
               src="<%= m.photo %>"
               alt="<%= m.name %>"
               loading="lazy">
        <% } else { %>
          <div class="tg-img tg-img--placeholder" aria-hidden="true">
            <span><%= m.firstName.charAt(0) %><%= m.name.split(' ').pop().charAt(0) %></span>
          </div>
        <% } %>

        <span class="tg-veil" aria-hidden="true"></span>
        <span class="tg-side-label" aria-hidden="true"><%= m.firstName %></span>

        <span class="tg-info">
          <% if (m.linkedin) { %>
          <a class="tg-linkedin"
             href="<%= m.linkedin %>"
             target="_blank" rel="noopener noreferrer"
             aria-label="<%= m.name %> on LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" fill="currentColor"/>
              <rect x="2" y="9" width="4" height="12" fill="currentColor"/>
              <circle cx="4" cy="4" r="2" fill="currentColor"/>
            </svg>
          </a>
          <% } %>
          <span class="tg-text">
            <span class="tg-name"><%= m.name %></span>
            <span class="tg-role"><%= m.role %></span>
          </span>
        </span>
      </div>
      <% }); %>
    </div>
  </section>

  <!-- ══ FINAL CTA — light variant (matches Tech section) ══ -->
  <section class="cta-band cta-band--light">
    <h2>Work With a Corporate Services Partner You Can Trust</h2>
    <p>SRP International brings together the expertise, technology, and commitment to help your business operate with confidence — now and for years ahead.</p>
    <div class="cta-band-btns">
      <a href="/contact" class="btn btn-primary">Schedule a Consultation <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/services" class="btn btn-outline">Explore Services</a>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <%- include('partials/scripts') %>
</body>
</html>
