<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.excerpt,
    "image": siteBase + post.image,
    "datePublished": post.date,
    "author": { "@type": "Person", "name": post.author.name },
    "publisher": {
      "@type": "Organization",
      "name": "SRP International",
      "logo": { "@type": "ImageObject", "url": siteBase + "/images/logo/srp-international-logo.png" }
    },
    "mainEntityOfPage": pageUrl
  }) %>
  </script>
</head>
<body>
  <%- include('partials/header') %>

  <!-- ══ ARTICLE HEADER ══════════════════════════════ -->
  <article id="main-content">
    <header class="post-hero">
      <div class="hero-grid"></div>
      <div class="post-hero-content">
        <div class="breadcrumb">
          <a href="/">Home</a>
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
          <a href="/blog">Insights</a>
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
          <span><%= categoryName(post.category) %></span>
        </div>
        <a class="post-category-pill" href="/blog?category=<%= post.category %>"><%= categoryName(post.category) %></a>
        <h1 class="post-title"><%= post.title %></h1>
        <div class="post-byline">
          <img class="post-byline-avatar" src="<%= post.author.avatar %>" alt="" width="44" height="44">
          <div class="post-byline-text">
            <span class="post-byline-author"><%= post.author.name %><% if (post.author.role) { %> — <%= post.author.role %><% } %></span>
            <span class="post-byline-meta"><%= post.author.department || categoryName(post.category) %> · <%= fmtDate(post.date) %> · <%= readingTime(post) %> min read</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Cover image -->
    <div class="post-cover">
      <div class="container">
        <img src="<%= post.image %>" alt="<%= post.title %>" width="1200" height="600">
      </div>
    </div>

    <!-- ══ BODY ════════════════════════════════════════ -->
    <div class="post-body">
      <% post.body.forEach(function(block) { %>
        <% if (block.h2) { %>
          <h2><%= block.h2 %></h2>
        <% } else if (block.list) { %>
          <ul>
            <% block.list.forEach(function(item) { %><li><%= item %></li><% }); %>
          </ul>
        <% } else if (block.p) { %>
          <p><%= block.p %></p>
        <% } %>
      <% }); %>

      <!-- Author bio -->
      <div class="post-author-card">
        <img src="<%= post.author.avatar %>" alt="" width="64" height="64">
        <div>
          <span class="post-author-name"><%= post.author.name %></span>
          <span class="post-author-role"><%= post.author.role %><% if (post.author.org !== null) { %>, <%= post.author.org || 'SRP International' %><% } %></span>
        </div>
      </div>

      <!-- Share / back -->
      <div class="post-foot">
        <a href="/blog" class="post-back">← Back to all insights</a>
      </div>
    </div>
  </article>

  <!-- ══ RELATED ═════════════════════════════════════ -->
  <% if (related.length) { %>
  <section class="section section-alt post-related">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Keep Reading</div>
        <h2 class="heading">Related Insights</h2>
      </div>
      <div class="blog-grid blog-grid--3">
        <% related.forEach(function(post) { %>
          <%- include('partials/blog-card', { post: post }) %>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ══ CTA ═════════════════════════════════════════ -->
  <section class="cta-band">
    <h2>Turn insight into action</h2>
    <p>Whatever market you’re weighing, our advisors can help you move with confidence — incorporation, tax, accounting, and HR under one partner.</p>
    <div class="cta-band-btns">
      <a href="/contact" class="btn btn-white">Schedule a Consultation <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/services" class="btn btn-ghost">Explore Services</a>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <%- include('partials/scripts') %>
</body>
</html>
