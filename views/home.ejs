<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="page-home">
  <%- include('partials/header') %>

  <main id="main-content">
  <!-- ══ HERO — SPLIT with unified cityscape background ══
       The 4 country landscapes span the FULL hero width
       (behind both panes) and crossfade as the user scrolls.
       Left pane = brand messaging with subtle dark overlay
       Right pane = country name + region/city labels + progress
  ══════════════════════════════════════════════════════════════ -->
  <section id="heroFx" class="hero-fx cinematic-fx" aria-label="Hero — SRP International">
    <div class="fx-fixed-section">
      <div class="fx-fixed">

        <!-- ── Full-width cityscape backgrounds (behind everything) ── -->
        <div class="fx-bgs" aria-hidden="true">
          <div class="fx-bg">
            <img class="fx-bg-img" src="/images/cities/sri-lanka.jpg" alt="" loading="eager">
            <div class="fx-bg-overlay"></div>
          </div>
          <div class="fx-bg">
            <img class="fx-bg-img" src="/images/cities/singapore.jpg" alt="" loading="lazy">
            <div class="fx-bg-overlay"></div>
          </div>
          <div class="fx-bg">
            <img class="fx-bg-img" src="/images/cities/uae.webp" alt="" loading="lazy">
            <div class="fx-bg-overlay"></div>
          </div>
          <div class="fx-bg">
            <img class="fx-bg-img" src="/images/cities/uk.jpg" alt="" loading="lazy">
            <div class="fx-bg-overlay"></div>
          </div>
        </div>

        <!-- ── Split content layer (over the cityscape) ── -->
        <div class="hero-split">

          <!-- LEFT: brand messaging, sits over cityscape with light dark gradient -->
          <div class="hero-text-pane">
            <div class="hero-pane-content">
              <div class="hero-eyebrow">
                <span class="pulse-dot" aria-hidden="true"></span>Trusted Corporate Services Partner
              </div>
              <h1 class="hero-pane-title">Global Corporate Services for <em>Ambitious Businesses</em></h1>
              <p class="hero-pane-text">SRP International helps companies, entrepreneurs, and investors incorporate, manage, grow, and stay compliant with trusted corporate services and business support.</p>
              <div class="hero-pane-ctas">
                <a href="/contact" class="btn btn-white">
                  Schedule a Consultation
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="/sri-lanka" class="btn btn-ghost">Explore Services</a>
              </div>
            </div>
          </div>

          <!-- RIGHT: country name + region/city labels + progress -->
          <div class="hero-fx-pane">
            <div class="fx-grid">
              <div class="fx-content">
                <div class="fx-center">
                  <div class="fx-featured active" data-index="0">
                    <h2 class="fx-featured-title">
                      <span class="fx-word-mask"><span class="fx-word">Sri</span></span>
                      <span class="fx-word-mask"><span class="fx-word">Lanka</span></span>
                    </h2>
                    <div class="fx-featured-region">South Asia</div>
                  </div>
                  <div class="fx-featured" data-index="1">
                    <h2 class="fx-featured-title">
                      <span class="fx-word-mask"><span class="fx-word">Singapore</span></span>
                    </h2>
                    <div class="fx-featured-region">South-East Asia</div>
                  </div>
                  <div class="fx-featured" data-index="2">
                    <h2 class="fx-featured-title">
                      <span class="fx-word-mask"><span class="fx-word">United</span></span>
                      <span class="fx-word-mask"><span class="fx-word">Arab</span></span>
                      <span class="fx-word-mask"><span class="fx-word">Emirates</span></span>
                    </h2>
                    <div class="fx-featured-region">Middle East</div>
                  </div>
                  <div class="fx-featured" data-index="3">
                    <h2 class="fx-featured-title">
                      <span class="fx-word-mask"><span class="fx-word">United</span></span>
                      <span class="fx-word-mask"><span class="fx-word">Kingdom</span></span>
                    </h2>
                    <div class="fx-featured-region">Europe</div>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ══ TRUST METRICS ═══════════════════════════════ -->
  <section class="metrics-section">
    <div class="container">
      <div class="metrics-grid">
        <div class="card card-metric reveal">
          <div class="metric-icon">
            <svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6l7-3 7 3"/><path d="M4 10v11"/><path d="M20 10v11"/><path d="M8 14v3"/><path d="M12 14v3"/><path d="M16 14v3"/></svg>
          </div>
          <div class="metric-num" data-counter data-target="650" data-suffix="+">0</div>
          <div class="metric-label">Companies</div>
        </div>
        <div class="card card-metric reveal reveal-delay-1">
          <div class="metric-icon">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="metric-num" data-counter data-target="450" data-suffix="+">0</div>
          <div class="metric-label">Satisfied Clients</div>
        </div>
        <div class="card card-metric reveal reveal-delay-2">
          <div class="metric-icon">
            <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <div class="metric-num" data-counter data-target="1000" data-suffix="+">0</div>
          <div class="metric-label">Projects</div>
        </div>
        <div class="card card-metric reveal reveal-delay-3">
          <div class="metric-icon">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="metric-num" data-counter data-target="70" data-suffix="+">0</div>
          <div class="metric-label">Staff</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ SERVICES OVERVIEW ═══════════════════════════ -->
  <section class="section" id="services-overview">
    <div class="container">
      <div class="section-head">
        <div class="kicker">What We Offer</div>
        <h2 class="heading">Integrated Corporate Services for Every Stage of Your Business</h2>
        <p class="subheading">We provide the expert support your business needs to grow confidently — compliant, informed, and well-managed at every stage.</p>
      </div>
      <div class="grid-2 services-grid-home">
        <a href="/sri-lanka/company-secretarial" class="card card-service reveal">
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3 class="svc-title">Company Incorporation & Governance</h3>
          <p class="svc-body">Ensure your company is correctly structured and compliant with all local laws. Our team manages incorporation, compliance, and governance to give your operations a secure foundation.</p>
          <span class="svc-link">
            Learn More
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/sri-lanka/financial-services" class="card card-service reveal reveal-delay-1">
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="svc-title">Financial Services</h3>
          <p class="svc-body">Using modern financial systems, we deliver monthly management accounting, invoicing, cash management, and annual financial statement preparation with expert advisory support.</p>
          <span class="svc-link">
            Learn More
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/sri-lanka/research-planning" class="card card-service reveal reveal-delay-2">
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <h3 class="svc-title">Research & Business Planning</h3>
          <p class="svc-body">Gain valuable insight into new ventures and existing investments through feasibility studies, business plans, market research, and bespoke equity research reports.</p>
          <span class="svc-link">
            Learn More
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/sri-lanka/hr-management" class="card card-service reveal reveal-delay-3">
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="svc-title">Human Resource Management</h3>
          <p class="svc-body">Handle your staff effectively with support in recruitment, documentation, performance reviews, payroll, HR policies, and industrial dispute management.</p>
          <span class="svc-link">
            Learn More
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>
      <div style="text-align:center; margin-top:48px;">
        <a href="/sri-lanka" class="btn btn-outline">View All Services <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>

  <!-- ══ BUSINESS JOURNEY ════════════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div class="kicker">How We Work</div>
        <h2 class="heading">Your Business Journey With SRP</h2>
        <p class="subheading">A structured approach to corporate services that grows with your business at every stage.</p>
      </div>
      <div class="timeline reveal">
        <div class="timeline-track"></div>
        <div class="timeline-step">
          <div class="timeline-dot">1</div>
          <h4>Understand Your Goals</h4>
          <p>We learn about your business objectives, challenges, and regulatory requirements.</p>
        </div>
        <div class="timeline-step">
          <div class="timeline-dot">2</div>
          <h4>Incorporate & Structure</h4>
          <p>We set up and register your company with the right corporate structure.</p>
        </div>
        <div class="timeline-step">
          <div class="timeline-dot">3</div>
          <h4>Manage Compliance</h4>
          <p>We handle all regulatory filings, reporting, and ongoing compliance requirements.</p>
        </div>
        <div class="timeline-step">
          <div class="timeline-dot">4</div>
          <h4>Support Operations</h4>
          <p>We manage finance, HR, and operational services for efficient day-to-day business.</p>
        </div>
        <div class="timeline-step">
          <div class="timeline-dot">5</div>
          <h4>Help You Grow</h4>
          <p>We provide research, strategic planning, and advisory to support your expansion.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ GLOBAL PRESENCE ═════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Where We Operate</div>
        <h2 class="heading">International Support. Local Expertise.</h2>
        <p class="subheading">With offices and operations across multiple jurisdictions, SRP International provides coordinated corporate services wherever your business operates.</p>
      </div>

      <!-- Interactive D3 world map -->
      <div id="worldMap" class="world-map-container reveal" role="region" aria-label="Interactive world map"></div>

      <!-- 4 Country cards -->
      <div class="loc-grid reveal" style="margin-top:52px;">

        <!-- Sri Lanka -->
        <div class="loc-card loc-card--primary">
          <span class="loc-watermark" aria-hidden="true">LK</span>
          <div class="loc-header">
            <img class="flag-circle" src="https://flagcdn.com/w160/lk.png" alt="Sri Lanka flag" width="44" height="44" loading="lazy">
            <div class="loc-country-name">Sri Lanka</div>
          </div>
          <div class="loc-divider"></div>
          <div class="loc-city">Asia</div>
          <p class="loc-desc">Corporate services across Sri Lanka and the South Asia region</p>
          <div class="loc-badge loc-badge--hq">
            <svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6l7-3 7 3"/><path d="M4 10v11"/><path d="M20 10v11"/></svg>
            Operational Hub
          </div>
        </div>

        <!-- Singapore -->
        <div class="loc-card">
          <span class="loc-watermark" aria-hidden="true">SG</span>
          <div class="loc-header">
            <img class="flag-circle" src="https://flagcdn.com/w160/sg.png" alt="Singapore flag" width="44" height="44" loading="lazy">
            <div class="loc-country-name">Singapore</div>
          </div>
          <div class="loc-divider"></div>
          <div class="loc-city">South-East Asia</div>
          <p class="loc-desc">Corporate services across Singapore and the South-East Asia region</p>
          <div class="loc-badge">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Regional Office
          </div>
        </div>

        <!-- UAE -->
        <div class="loc-card">
          <span class="loc-watermark" aria-hidden="true">AE</span>
          <div class="loc-header">
            <img class="flag-circle" src="/images/flags/ae.png" alt="UAE flag" width="44" height="44" loading="lazy">
            <div class="loc-country-name">United Arab Emirates</div>
          </div>
          <div class="loc-divider"></div>
          <div class="loc-city">Dubai</div>
          <p class="loc-desc">Corporate services across the Middle East and GCC region</p>
          <div class="loc-badge">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Regional Office
          </div>
        </div>

        <!-- UK -->
        <div class="loc-card">
          <span class="loc-watermark" aria-hidden="true">GB</span>
          <div class="loc-header">
            <img class="flag-circle" src="https://flagcdn.com/w160/gb.png" alt="United Kingdom flag" width="44" height="44" loading="lazy">
            <div class="loc-country-name">United Kingdom</div>
          </div>
          <div class="loc-divider"></div>
          <div class="loc-city">United Kingdom</div>
          <p class="loc-desc">Corporate services across the United Kingdom and Europe</p>
          <div class="loc-badge">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Regional Office
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══ WHY CHOOSE SRP ══════════════════════════════ -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Why SRP</div>
        <h2 class="heading">Why Businesses Choose SRP International</h2>
        <p class="subheading">Our clients trust us because we deliver responsive, reliable, and results-driven corporate services.</p>
      </div>
      <div class="grid-4 why-grid">
        <div class="card card-value reveal">
          <div class="value-icon">
            <svg viewBox="0 0 24 24"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
          </div>
          <div class="value-title">Responsive</div>
          <div class="value-desc">We respond quickly and keep clients informed at every stage of service delivery.</div>
        </div>
        <div class="card card-value reveal reveal-delay-1">
          <div class="value-icon">
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <div class="value-title">Client-Driven</div>
          <div class="value-desc">Every solution is tailored to your specific business needs, scale, and objectives.</div>
        </div>
        <div class="card card-value reveal reveal-delay-2">
          <div class="value-icon">
            <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="value-title">Experienced & Capable</div>
          <div class="value-desc">Our team brings deep expertise across corporate law, finance, research, and human resources.</div>
        </div>
        <div class="card card-value reveal reveal-delay-3">
          <div class="value-icon">
            <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div class="value-title">Cost-Effective</div>
          <div class="value-desc">Premium corporate services at competitive rates, delivering real value for your investment.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ TESTIMONIALS — 3-column infinite scroll ════ -->
  <section class="ts-section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div class="kicker">Client Confidence</div>
        <h2 class="heading">Trusted by Businesses Across Multiple Markets</h2>
        <p class="subheading">Our clients trust SRP International to deliver reliable, transparent, and efficient corporate services.</p>
      </div>
    </div>

    <%
      /* 9 testimonials spread across 3 columns.
         Each column's cards are duplicated in HTML
         for seamless CSS loop (translateY -50%). */
      const testimonials = [
        /* Col 1 */
        { name:'Managing Director',    role:'International Trading Company',    img:'1',  text:'SRP International has been an invaluable partner in managing our corporate compliance and financial reporting. Their team is responsive, professional, and always ahead of deadlines.' },
        { name:'Chief Financial Officer', role:'Logistics Group',               img:'4',  text:'Outstanding financial management services. SRP keeps our accounts audit-ready and delivers clear monthly reports that genuinely help us make better decisions.' },
        { name:'Head of Operations',   role:'Manufacturing Conglomerate',       img:'7',  text:'We rely on SRP for our entire compliance calendar. They flag issues before they become problems — that level of proactive support is rare and extremely valuable.' },
        /* Col 2 */
        { name:'CEO & Founder',        role:'Technology Startup',               img:'2',  text:'The research and business planning services from SRP gave us the clarity we needed to enter a new market. Their feasibility study was thorough, well-structured, and highly actionable.' },
        { name:'Head of People',       role:'E-Commerce Company',               img:'5',  text:'SRP\'s HR team helped us build a structured recruitment process from scratch. They drafted all our contracts and policies — exactly what a fast-growing team needs.' },
        { name:'Founder',              role:'FinTech Startup',                  img:'8',  text:'The feasibility study SRP delivered was instrumental in securing our Series A funding. Investors were impressed by the depth of analysis and market validation.' },
        /* Col 3 */
        { name:'Operations Director',  role:'Regional Investment Firm',         img:'3',  text:'From company incorporation to ongoing HR management, SRP handles everything seamlessly. They feel like an extension of our team rather than an external provider.' },
        { name:'Managing Partner',     role:'Consulting Firm',                  img:'6',  text:'Excellent financial reporting and tax advisory services. Our books have never been in better shape and we feel completely in control of our financial position.' },
        { name:'CEO',                  role:'Export Company',                   img:'9',  text:'SRP\'s cross-jurisdiction expertise is unmatched. Expanding into Singapore and Dubai would have been far more complex without their coordinated support on both fronts.' }
      ];
      const col1 = testimonials.slice(0,3);
      const col2 = testimonials.slice(3,6);
      const col3 = testimonials.slice(6,9);
    %>

    <div class="ts-outer" aria-label="Client testimonials">
      <% [col1, col2, col3].forEach(function(col, ci) { %>
      <div class="ts-col" style="--dur:<%- [32,26,38][ci] %>s">
        <%/* Original cards */%>
        <% col.forEach(function(t) { %>
        <div class="ts-card">
          <div class="ts-header">
            <img class="ts-avatar"
                 src="https://i.pravatar.cc/80?img=<%- t.img %>"
                 alt="<%- t.name %>"
                 width="48" height="48"
                 loading="lazy">
            <div>
              <div class="ts-name"><%- t.name %></div>
              <div class="ts-role"><%- t.role %></div>
            </div>
          </div>
          <p class="ts-text"><%- t.text %></p>
          <div class="ts-stars" aria-label="5 stars">★★★★★</div>
        </div>
        <% }); %>
        <%/* Duplicates for seamless loop */%>
        <% col.forEach(function(t) { %>
        <div class="ts-card" aria-hidden="true">
          <div class="ts-header">
            <img class="ts-avatar"
                 src="https://i.pravatar.cc/80?img=<%- t.img %>"
                 alt=""
                 width="48" height="48"
                 loading="lazy">
            <div>
              <div class="ts-name"><%- t.name %></div>
              <div class="ts-role"><%- t.role %></div>
            </div>
          </div>
          <p class="ts-text"><%- t.text %></p>
          <div class="ts-stars" aria-hidden="true">★★★★★</div>
        </div>
        <% }); %>
      </div>
      <% }); %>
    </div>
  </section>

  <!-- ══ FINAL CTA ═══════════════════════════════════ -->
  <section class="cta-band">
    <h2>Ready to Simplify Your Corporate Operations?</h2>
    <p>Partner with SRP International for reliable corporate services, business support, and technology-enabled client management.</p>
    <div class="cta-band-btns">
      <a href="/contact" class="btn btn-white">Schedule a Consultation <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/contact" class="btn btn-ghost">Contact SRP</a>
    </div>
  </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <%- include('partials/scripts') %>

  <!-- Cinematic FX (hero) + D3 world map (Where We Operate) -->
  <link rel="stylesheet" href="/css/cinematic-fx.css">
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
  <script src="/js/cinematic-fx.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js" defer></script>
  <script src="/js/map.js" defer></script>
</body>
</html>
