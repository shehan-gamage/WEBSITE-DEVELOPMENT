<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="page-home">
  <%- include('partials/header') %>

  <main id="main-content">
  <!-- ══ HERO — SPLIT with unified cityscape background ══
       The 4 country landscapes span the FULL hero width
       (behind both panes) and crossfade as the user scrolls.
       Left pane = brand messaging with subtle dark overlay
       Right pane = country name + region/city labels + progress
  ══════════════════════════════════════════════════════════════ -->
  <section id="heroFx" class="hero-fx cinematic-fx" aria-label="Hero — SRP International">
    <div class="fx-fixed-section">
      <div class="fx-fixed">

        <!-- ── Full-width cityscape backgrounds (behind everything) ── -->
        <div class="fx-bgs" aria-hidden="true">
          <div class="fx-bg">
            <img class="fx-bg-img" src="/images/cities/sri-lanka.jpg" alt="" loading="eager">
            <div class="fx-bg-overlay"></div>
          </div>
          <div class="fx-bg">
            <img class="fx-bg-img" src="/images/cities/singapore.jpg" alt="" loading="lazy">
            <div class="fx-bg-overlay"></div>
          </div>
          <div class="fx-bg">
            <img class="fx-bg-img" src="/images/cities/uae.webp" alt="" loading="lazy">
            <div class="fx-bg-overlay"></div>
          </div>
          <div class="fx-bg">
            <img class="fx-bg-img" src="/images/cities/uk.jpg" alt="" loading="lazy">
            <div class="fx-bg-overlay"></div>
          </div>
          <div class="fx-bg">
            <img class="fx-bg-img" src="/images/cities/hong-kong.jpg" alt="" loading="lazy">
            <div class="fx-bg-overlay"></div>
          </div>
        </div>

        <!-- ── Split content layer (over the cityscape) ── -->
        <div class="hero-split">

          <!-- LEFT: brand messaging, sits over cityscape with light dark gradient -->
          <div class="hero-text-pane">
            <div class="hero-pane-content">
              <div class="hero-eyebrow">
                <span class="pulse-dot" aria-hidden="true"></span>Your Trusted Corporate Services Partner
              </div>
              <h1 class="hero-pane-title">Corporate Services Built for the <em>Long Term</em></h1>
              <p class="hero-pane-text">SRP International helps companies, founders, and investors incorporate, operate, and grow — with dependable corporate services and steady support across every market we serve.</p>
              <div class="hero-pane-ctas">
                <a href="/contact" class="btn btn-white">
                  Schedule a Consultation
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="/sri-lanka" class="btn btn-ghost">Explore Services</a>
              </div>
            </div>
          </div>

          <!-- RIGHT: country name + region/city labels + progress -->
          <div class="hero-fx-pane">
            <div class="fx-grid">
              <div class="fx-content">
                <div class="fx-center">
                  <div class="fx-featured active" data-index="0">
                    <h2 class="fx-featured-title">
                      <span class="fx-word-mask"><span class="fx-word">Sri</span></span>
                      <span class="fx-word-mask"><span class="fx-word">Lanka</span></span>
                    </h2>
                    <div class="fx-featured-region">South Asia</div>
                  </div>
                  <div class="fx-featured" data-index="1">
                    <h2 class="fx-featured-title">
                      <span class="fx-word-mask"><span class="fx-word">Singapore</span></span>
                    </h2>
                    <div class="fx-featured-region">South-East Asia</div>
                  </div>
                  <div class="fx-featured" data-index="2">
                    <h2 class="fx-featured-title">
                      <span class="fx-word-mask"><span class="fx-word">United</span></span>
                      <span class="fx-word-mask"><span class="fx-word">Arab</span></span>
                      <span class="fx-word-mask"><span class="fx-word">Emirates</span></span>
                    </h2>
                    <div class="fx-featured-region">Middle East</div>
                  </div>
                  <div class="fx-featured" data-index="3">
                    <h2 class="fx-featured-title">
                      <span class="fx-word-mask"><span class="fx-word">United</span></span>
                      <span class="fx-word-mask"><span class="fx-word">Kingdom</span></span>
                    </h2>
                    <div class="fx-featured-region">Europe</div>
                  </div>
                  <div class="fx-featured" data-index="4">
                    <h2 class="fx-featured-title">
                      <span class="fx-word-mask"><span class="fx-word">Hong</span></span>
                      <span class="fx-word-mask"><span class="fx-word">Kong</span></span>
                    </h2>
                    <div class="fx-featured-region">East Asia</div>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ══ TRUST METRICS ═══════════════════════════════ -->
  <section class="metrics-section">
    <div class="container">
      <div class="metrics-grid">
        <div class="card card-metric reveal">
          <div class="metric-icon">
            <svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6l7-3 7 3"/><path d="M4 10v11"/><path d="M20 10v11"/><path d="M8 14v3"/><path d="M12 14v3"/><path d="M16 14v3"/></svg>
          </div>
          <div class="metric-num" data-counter data-target="650" data-suffix="+">0</div>
          <div class="metric-label">Companies</div>
        </div>
        <div class="card card-metric reveal reveal-delay-1">
          <div class="metric-icon">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="metric-num" data-counter data-target="450" data-suffix="+">0</div>
          <div class="metric-label">Satisfied Clients</div>
        </div>
        <div class="card card-metric reveal reveal-delay-2">
          <div class="metric-icon">
            <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <div class="metric-num" data-counter data-target="1000" data-suffix="+">0</div>
          <div class="metric-label">Projects</div>
        </div>
        <div class="card card-metric reveal reveal-delay-3">
          <div class="metric-icon">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="metric-num" data-counter data-target="70" data-suffix="+">0</div>
          <div class="metric-label">Staff</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ SERVICES OVERVIEW ═══════════════════════════ -->
  <section class="section" id="services-overview">
    <div class="container">
      <div class="section-head">
        <div class="kicker">What We Offer</div>
        <h2 class="heading">Corporate Services for Every Stage of Your Business</h2>
        <p class="subheading">The support your business needs to stay compliant, well-organized, and ready to grow — dependable at every stage.</p>
      </div>
      <div class="grid-2 services-grid-home">
        <a href="/sri-lanka/company-secretarial" class="card card-service reveal">
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3 class="svc-title">Company Incorporation & Governance</h3>
          <p class="svc-body">Set your company up correctly and keep it that way. We handle incorporation, ongoing compliance, and governance, so your business stands on a solid, well-documented foundation.</p>
          <span class="svc-link">
            Learn More
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/sri-lanka/financial-services" class="card card-service reveal reveal-delay-1">
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="svc-title">Financial Services</h3>
          <p class="svc-body">Clear, reliable numbers you can plan around. We deliver monthly management accounts, invoicing, cash management, and year-end financial statements, with experienced advisory support behind every report.</p>
          <span class="svc-link">
            Learn More
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/sri-lanka/research-planning" class="card card-service reveal reveal-delay-2">
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <h3 class="svc-title">Research & Business Planning</h3>
          <p class="svc-body">Make decisions with confidence. We provide feasibility studies, business plans, market research, and tailored equity research to give you a clear view of new ventures and existing investments.</p>
          <span class="svc-link">
            Learn More
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/sri-lanka/hr-management" class="card card-service reveal reveal-delay-3">
          <div class="svc-icon">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="svc-title">Human Resource Management</h3>
          <p class="svc-body">Look after your people with structure and care. We support recruitment, documentation, performance reviews, payroll, HR policies, and the handling of workplace disputes.</p>
          <span class="svc-link">
            Learn More
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>
      <div style="text-align:center; margin-top:48px;">
        <a href="/sri-lanka" class="btn btn-outline">View All Services <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>

  <!-- ══ BUSINESS JOURNEY ════════════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div class="kicker">How We Work</div>
        <h2 class="heading">Your Business Journey With SRP</h2>
        <p class="subheading">A clear, step-by-step approach to corporate services — one that grows with your business and stays with you for the long run.</p>
      </div>
      <div class="timeline reveal">
        <div class="timeline-track"></div>
        <div class="timeline-step">
          <div class="timeline-dot">1</div>
          <h4>Understand Your Goals</h4>
          <p>We start by learning your objectives, your challenges, and the rules you need to meet.</p>
        </div>
        <div class="timeline-step">
          <div class="timeline-dot">2</div>
          <h4>Incorporate & Structure</h4>
          <p>We register your company and set it up with the right structure from day one.</p>
        </div>
        <div class="timeline-step">
          <div class="timeline-dot">3</div>
          <h4>Manage Compliance</h4>
          <p>We take care of filings, reporting, and the deadlines that keep you in good standing.</p>
        </div>
        <div class="timeline-step">
          <div class="timeline-dot">4</div>
          <h4>Support Operations</h4>
          <p>We manage finance, HR, and day-to-day operations so your business runs smoothly.</p>
        </div>
        <div class="timeline-step">
          <div class="timeline-dot">5</div>
          <h4>Help You Grow</h4>
          <p>We provide research, planning, and advice to support your next stage of growth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ GLOBAL PRESENCE ═════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Where We Operate</div>
        <h2 class="heading">International Support. Local Expertise.</h2>
        <p class="subheading">With offices across five markets, SRP International delivers coordinated corporate services wherever your business operates — and the local knowledge to get the details right.</p>
      </div>

      <!-- Interactive D3 world map — hover a flag for office details -->
      <div id="worldMap" class="world-map-container reveal" role="region" aria-label="Interactive world map — hover a flag for office details"></div>
    </div>
  </section>

  <!-- ══ WHY CHOOSE SRP ══════════════════════════════ -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <div class="kicker">Why SRP</div>
        <h2 class="heading">Why Businesses Stay With SRP International</h2>
        <p class="subheading">Clients stay with us because we're responsive, dependable, and genuinely invested in the long-term health of their business.</p>
      </div>
      <div class="grid-4 why-grid">
        <div class="card card-value reveal">
          <div class="value-icon">
            <svg viewBox="0 0 24 24"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
          </div>
          <div class="value-title">Responsive</div>
          <div class="value-desc">We reply quickly and keep you informed at every stage — no chasing, no surprises.</div>
        </div>
        <div class="card card-value reveal reveal-delay-1">
          <div class="value-icon">
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <div class="value-title">Client-Driven</div>
          <div class="value-desc">Every solution is shaped around your business, your scale, and your goals.</div>
        </div>
        <div class="card card-value reveal reveal-delay-2">
          <div class="value-icon">
            <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="value-title">Experienced & Capable</div>
          <div class="value-desc">Deep, hands-on expertise across corporate law, finance, research, and human resources.</div>
        </div>
        <div class="card card-value reveal reveal-delay-3">
          <div class="value-icon">
            <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div class="value-title">Cost-Effective</div>
          <div class="value-desc">Professional corporate services at fair, transparent rates — real value for what you invest.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ TESTIMONIALS — 3-column infinite scroll ════ -->
  <section class="ts-section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <div class="kicker">Client Confidence</div>
        <h2 class="heading">Trusted by Businesses Across Multiple Markets</h2>
        <p class="subheading">Businesses across our markets rely on SRP International for reliable, transparent, and steady corporate services.</p>
      </div>
    </div>

    <%
      /* Real, named client testimonials. Rendered into a 3-column auto-scroll.
         Add new ones to this array as they come in. */
      const testimonials = [
        { name:'Michael', role:'Owner, Investment Company — UAE', photo:'/images/testimonials/michael.jpg', text:'I recently opened an offshore company in Dubai with SRP after a good friend recommended them. From my first conversation with Aaron, the lead partner, I felt completely at ease — he answered every question perfectly. Rochelle then guided me through every government department, professional at every step; I can\'t recommend her highly enough. The whole company was set up in just 10 working days.' },
        { name:'Nuwan', role:'Regional Manager, Travel Agency — Sri Lanka', photo:'/images/testimonials/nuwan.jpg', text:'SRP has been a strategic partner to Bunnik Tours Sri Lanka since 2022, delivering an integrated suite of HR, accounting, and payroll services to a consistently high standard of expertise and governance. What sets them apart is a proactive, forward-thinking approach and genuine commitment to client success — responsive, adaptable, and often anticipating our needs. They have contributed meaningfully to the stability and scalability of our Sri Lankan operations, and we confidently endorse their services to any organisation seeking a reliable, high-performing partner.' },
        { name:'Mary', role:'Owner, Boutique Villa — Sri Lanka', photo:'/images/testimonials/mary.jpg', text:'We came to SRP through a recommendation, and as foreigners who knew nothing about the country, it was fantastic — they gave us information we could never have found on our own. We recommend SRP 200%, especially Rochelle, who knows everything and is always there to help, no matter what. They really are the best at what they do.' },
        { name:'Carl', role:'CEO, Media Agency — UAE', photo:'/images/testimonials/carl.jpg', text:'When I first looked at opportunities in Sri Lanka, several people told me, "Speak to SRP" — some of the best advice I received. Over the past few years they have helped me establish and manage two companies here, handling everything from formation and compliance to accounting and tax. Having run businesses for over 35 years and worked with countless providers worldwide, I can honestly say SRP ranks among the very best — responsive, proactive, and always going the extra mile. For anyone investing or expanding into Sri Lanka, I would recommend them without hesitation.' },
        { name:'Hameed', role:'Owner, Boutique Villa — Sri Lanka', photo:'/images/testimonials/hameed.jpg', text:'It has been a true pleasure working with SRP in handling my company setup in Sri Lanka while I\'m based in Dubai. From day one of our phone call with SRP, the whole process has been clearly defined along with the processing time. I was assigned Rochelle from SRP, who has handled my case in a professional manner with updates along the way at each stage of the setup. I would definitely recommend anyone planning to set up a business in Sri Lanka to go through SRP. Thank you once again Rochelle and the whole SRP team for the smooth process and clear communication, and I look forward to maintaining this relationship along the way.' },
        { name:'Swasha', role:'Director, Foundation — Sri Lanka', photo:'/images/testimonials/swasha.jpg', text:'Nama Sanctuary Foundation, which is a very small family foundation working with survivors of domestic violence in Sri Lanka, has been working with SRP for approximately two years. They have been doing all the payroll and bookkeeping for us, and I have been happy with their services.' },
        { name:'Zander', role:'Director, Boutique Hotel — Sri Lanka', photo:'/images/testimonials/zander.jpg', text:'My business has been with SRP since it began in 2019. We have always had a great experience with the SRP team, but over the last two years the service and level of work being carried out is far beyond what I expected from a business operating in Sri Lanka. Every call and question is answered in an incredibly timely fashion, and the advice and support is second to none. SRP feels more like KPMG, but the personal touch is always present from the SRP team. I recommend them to everyone who asks.' },
        { name:'Matt', role:'Owner, Boutique Hotel — Sri Lanka', photo:'/images/testimonials/matt.jpg', text:'My experience with SRP has been nothing but exceptional. No matter what questions are asked for the team to negotiate, it is always met with a prompt response and nothing seems to be too hard to help with. SRP has also given myself and my business, as a foreign owner within Sri Lanka, peace of mind that we are doing everything legally and correctly, thanks to the professionalism of SRP and the entire team. I can\'t recommend them highly enough for anyone looking for business support. I would also like to personally thank Imthad, my client liaison for many years, for his unwavering and dedicated support — it\'s been greatly appreciated.' },
      ];
      /* Spread across 3 auto-scrolling columns; cards are duplicated in HTML
         so the CSS loop (translateY -50%) is seamless. As more testimonials
         are added to the array, just rebalance these slices. */
      const col1 = testimonials.slice(0, 3);
      const col2 = testimonials.slice(3, 6);
      const col3 = testimonials.slice(6, 8);
    %>

    <div class="ts-outer" aria-label="Client testimonials">
      <% [col1, col2, col3].forEach(function(col, ci) { %>
      <div class="ts-col" style="--dur:<%- [32,26,38][ci] %>s">
        <% [false, true].forEach(function(isDup) { %>
        <% col.forEach(function(t) { %>
        <figure class="ts-card"<%- isDup ? ' aria-hidden="true"' : '' %>>
          <div class="ts-header">
            <img class="ts-avatar"
                 src="<%= t.photo %>"
                 alt="<%= isDup ? '' : t.name %>"
                 width="48" height="48"
                 loading="lazy">
            <figcaption>
              <div class="ts-name"><%= t.name %></div>
              <div class="ts-role"><%= t.role %></div>
            </figcaption>
          </div>
          <blockquote class="ts-text"><%= t.text %></blockquote>
          <div class="ts-stars"<%- isDup ? ' aria-hidden="true"' : ' aria-label="5 out of 5 stars"' %>>★★★★★</div>
        </figure>
        <% }); %>
        <% }); %>
      </div>
      <% }); %>
    </div>
  </section>

  <!-- ══ FINAL CTA ═══════════════════════════════════ -->
  <section class="cta-band">
    <h2>Ready to Simplify Your Corporate Operations?</h2>
    <p>Partner with SRP International for dependable corporate services, practical business support, and a relationship built to last.</p>
    <div class="cta-band-btns">
      <a href="/contact" class="btn btn-white">Schedule a Consultation <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/contact" class="btn btn-ghost">Contact SRP</a>
    </div>
  </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/chatbot') %>
  <%- include('partials/scripts') %>

  <!-- Cinematic FX (hero) + D3 world map (Where We Operate) -->
  <link rel="stylesheet" href="/css/cinematic-fx.css">
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
  <script src="/js/cinematic-fx.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js" defer></script>
  <script src="/js/map.js" defer></script>
</body>
</html>
